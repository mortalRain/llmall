<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>llmall</artifactId>
        <groupId>com.tongcheng</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>llmall-pay-service</artifactId>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--common-->
        <dependency>
            <groupId>com.tongcheng</groupId>
            <artifactId>llmall-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--api-->
        <dependency>
            <groupId>com.tongcheng</groupId>
            <artifactId>llmall-api</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--数据库-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <!--mybatis-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <!--nacos 服务注册发现-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!--nacos 配置中心：数据源/MyBatis/Redis/MQ/日志/接口文档口径统一由 Nacos 的 shared-*.yaml 下发，
             不再由 4 个服务各复制一份。bootstrap 阶段就要拉配置，故同时引 spring-cloud-starter-bootstrap。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!--AMQP依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--Redis：支付并发闸门（同一支付单同一时刻只允许一个支付流程），
            防止用户双击/客户端重试时并发通过"支付单待支付"检查而重复扣款-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
            <!-- Sentinel：熔断降级 + 限流。
             为什么必须引：Feign 的 fallbackFactory **只有**在 Sentinel 作为 Feign 的 Targeter 时才生效
             （Spring Cloud 默认的 DefaultTargeter 会直接忽略 fallback），
             不引就会出现"同一个 ItemClient，在有 Sentinel 的服务里失败走兜底、在这里失败直接抛异常"的行为分叉。
             历史上它导致过启动期 NPE（eager 注册 / 健康指标 / ContextUtil 静态初始化），
             对应规避已落在配置里：shared-log.yaml 关掉 sentinel 健康指标，各服务 sentinel.eager: false。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Feign 换 OkHttp：HttpURLConnection 没有连接池，且**默认读超时是无限等待** ——
             下游一旦卡住，调用方线程会被一起拖死（表现为整条链路雪崩）。
             超时值见各自 application.yaml 的 feign.client.config.default。-->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-okhttp</artifactId>
        </dependency></dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
