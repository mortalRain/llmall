# 复制为 .env 后按需修改（docker compose 会自动读取同目录 .env）
# 中间件地址：容器内互访用**容器名**，跨机 / 原生安装用 **IP**
#
# ⚠️ 先确认你的机器上中间件到底叫什么、在哪个网络：
#      docker ps --format '{{.Names}}\t{{.Networks}}'
#   本机 VM（192.168.189.128）实测（2026-10-11）：
#     容器：mysql、nacos、mq          ← RabbitMQ 的容器名是 **mq**，不是 rabbitmq
#     网络：nacos 原在 bridge，mysql/mq 原在 llmall-net（已用 docker network connect 接入 local-life）
#     Redis：**不在容器里**（原生安装，密码 123456）→ 容器内必须用宿主 IP，不能用 redis/127.0.0.1
#   若你是用 docker/docker-compose-infra-lite.yml 从零起的一整套，容器名则是
#     mysql / redis / nacos / **mq** —— RabbitMQ 的 container_name 写死为 mq
#     （那份 compose 里有注释说明"历史上叫 mq，不要改成 rabbitmq"），
#     所以届时把下面三行换成 redis / mq，**不要**写成 rabbitmq（容器内会 UnknownHostException）。

NACOS_ADDR=nacos:8848
NACOS_NAMESPACE=public

LLMALL_DB_HOST=mysql
LLMALL_DB_PW=123

# Redis 是原生安装（VM 上无 redis 容器）：容器里写容器名会 UnknownHostException
LLMALL_REDIS_HOST=192.168.189.128
LLMALL_REDIS_PW=123456

# RabbitMQ 的现役容器名是 mq
LLMALL_MQ_HOST=mq

LLMALL_ES_HOST=elasticsearch

# Sentinel 控制台地址。默认值按「控制台跑在宿主 Windows、服务跑在 VM 容器里」取：
# 容器经 VMnet8 网关（192.168.189.1）回连宿主的 8090，需要 Windows 放行 8090 入站。
# 若控制台也跑在这台机器的容器里，改成 sentinel-dashboard:8090 即可（不用重新打镜像）。
LLMALL_SENTINEL_DASHBOARD=192.168.189.1:8090

# 应用容器加入的外部 docker 网络名（需与中间件所在网络一致）
APP_NETWORK=local-life

# ---------------------------------------------------------------- 凭据（仅本文件带演示默认值）
# 【注意】本文件是**入库存档的示例**，`.env` 才是实际生效的那份，且 `.env` 已被 .gitignore 排除。
#   compose 与 demo.ps1 都从 .env 读下列键，**compose 里不再硬编码任何口令**（缺失会直接报错而不是用默认值）。
#   ⚠️ 对外部署前必须逐项替换并轮换；仓库里只有这一份"演示值"。
#
# MySQL root 口令（infra-lite 的 MYSQL_ROOT_PASSWORD），须与 LLMALL_DB_PW 一致
MYSQL_ROOT_PASSWORD=123
# Redis 口令（infra-lite 的 REDIS_PASSWORD），须与 LLMALL_REDIS_PW 一致
REDIS_PASSWORD=123456
# Seata Server（docker compose --profile full 时启动）：控制台账号密码 + TC 落库口令
SEATA_CONSOLE_PASSWORD=seata
SEATA_DB_PW=123
# JWT 签名私钥口令。注意 *.jks **不入库**：首次 clone 后先跑 scripts/gen-jks.ps1 生成私钥，
# 该脚本与服务 yaml 的 LLMALL_JKS_PASSWORD 默认值一致，改了要两边同步。
LLMALL_JKS_PASSWORD=llmall123

# 服务间内部凭证（x-internal-token）：下游只认「user-info + 本凭证」同时具备才采信身份，所以它等价于
#   一把可伪造任意用户身份的钥匙，**示例值故意留空**——不给可预测的默认串。
# 由 demo.ps1 首次生成 .env 时随机填充（加密安全随机源，32 位 hex）；手工部署请自行生成 32 位 hex。
LLMALL_INTERNAL_TOKEN=

# 服务间调用凭证（x-service-token）：只允许服务之间携带，用于"标记订单已支付""扣/退余额""改库存"
#   这类绝不能让用户触发的内部接口。与内部凭证同等重要，**示例值故意留空**，由 demo.ps1 首次生成时随机填充。
#   容器编排会强制要求本键存在且不等于仓库示例值，否则应用拒绝启动。
LLMALL_SERVICE_TOKEN=

# MySQL 容器映射到宿主的端口。本机原生 MySQL 服务占着 3306，所以用 3307；
#   全新机器没有这个冲突时，可以改回 3306，或直接删掉本键走 compose 的默认值（3306）。
#   容器内端口恒为 3306、应用容器之间按容器名 + 3306 互访，与本键无关。
MYSQL_HOST_PORT=3307
