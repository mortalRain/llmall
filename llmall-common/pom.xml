<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>llmall</artifactId>
        <groupId>com.tongcheng</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>llmall-common</artifactId>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!--
            spring-data-redis：只为编译 RedisScripts 里的 DefaultRedisScript 常量。
            用 provided 而不是 compile，理由与下面的 sentinel / spring-webmvc 一致：
              ① 真正的运行期依赖由**各服务**自己引入 spring-boot-starter-data-redis
                 （"哪个服务用 Redis"应该是显式的，而不是被 common 悄悄传染给所有模块）；
              ② 不把 Redis 客户端带进网关之外根本不需要它的模块（例如 item-service 目前不用缓存）。
            注意：provided 不传递，所以下面引用的 spring-data-redis 也不会进任何服务的运行期类路径 ——
            它们本来就有自己的 starter。
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--hutool工具包-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!--完成SpringMVC自动装配-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--日志-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 接口文档：knife4j 4.x 的 **openapi3** 分支（底层 springdoc-openapi 1.7，仍在维护）。
             原来的 openapi2 分支底层是 springfox 2.10.5 —— 2020 年后停更，且与 Spring Boot 2.6+
             有启动期 NPE 的已知不兼容，只能靠"把接口文档关掉"绕过（有的服务能看文档、有的不能）。
             换到这一支之后 9 个服务的 /doc.html 都能用，口径统一；注解同步迁到 swagger v3（io.swagger.v3.oas.annotations）。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>
        <!--caffeine-->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!--AMQP依赖-->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-amqp</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--Spring整合Rabbit依赖-->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--json处理-->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- jackson-databind 必须**显式**声明：上面那条是 provided，
             而 provided 依赖的**传递依赖不会进编译类路径** —— 少了这一条，
             MqConfig / JsonConfig 里的 com.fasterxml.jackson.databind 就编译不过。
             （实测：干净目录编译 llmall-common 必失败；旧 target/classes 存在时会掩盖这个问题。
              版本由 spring-boot-dependencies 统一管理，无需写版本号。） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Sentinel 规则集（SentinelRuleConfig）需要编译期可见 sentinel-core 的类型。
             用 provided 而不是 compile：
               ① 真正的运行期依赖由**各服务**自己引入 starter（这样"哪个服务有 Sentinel"是显式的）；
               ② 不把 sentinel 通过 common 传染给所有模块（网关是 WebFlux，用不到 MVC 那套适配器）。
             SentinelRuleConfig 上有 @ConditionalOnClass(SphU)，因此没引 sentinel 的模块会被安全跳过。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>