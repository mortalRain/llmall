<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>llmall</artifactId>
        <groupId>com.tongcheng</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>llmall-trade-service</artifactId>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <!--common-->
        <dependency>
            <groupId>com.tongcheng</groupId>
            <artifactId>llmall-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--api-->
        <dependency>
            <groupId>com.tongcheng</groupId>
            <artifactId>llmall-api</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--数据库-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <!--mybatis-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <!--nacos 服务注册发现-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!--nacos 配置中心：数据源/MyBatis/MQ/日志/接口文档口径统一由 Nacos 的 shared-*.yaml 下发，
             不再由 4 个服务各复制一份。bootstrap 阶段就要拉配置，故同时引 spring-cloud-starter-bootstrap。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!--AMQP依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--Seata AT：跨服务强一致（TM 角色）。
            注意：依赖在不在与"用不用"是两件事 —— 由 application.yaml 的 seata.enabled 控制，
            false 时 GlobalTransactionScanner 不注册，@GlobalTransactional 完全不生效。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>
        <!-- Sentinel + OkHttp（与 cart/content/promotion/search/shop 保持同一套口径）。
             这里原本**故意不引** sentinel，当时的结论是"没有 @SentinelResource 与规则，引进来只增加启动风险"。
             但那个结论漏掉了一半事实：Feign 的 fallbackFactory **只有** Sentinel 作为 Targeter 时才生效，
             不引的代价是 PayClient/ItemClient/ShopClient 的降级类在本服务里完全不执行 ——
             于是同一个 ItemClient 在 cart 里失败返回兜底、在 trade 里失败直接抛异常，
             "同一故障两种行为"比"没有降级"更难排查。现在改为统一引入，并补上最小规则集
             （见 llmall-common 的 SentinelRuleConfig）。历史上 Sentinel 的启动期 NPE 已由配置规避：
             shared-log.yaml 关掉 sentinel 健康指标、各服务 sentinel.eager: false。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Feign 换 OkHttp：HttpURLConnection 无连接池且**无读超时**（默认无限等待），
             下游卡住会把调用方线程拖死。超时见 application.yaml 的 feign.client.config.default。-->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-okhttp</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>