# ============================================================================
# 本地生活到店服务平台 · Git 忽略规则
# 原则：构建产物、运行日志、IDE 工程、本机环境文件一律不入库；
#       源码、配置模板、DDL、文档、演示数据脚本必须入库。
# ============================================================================

# ---------- 构建产物 ----------
target/
*.jar.original
*.class

# 前端依赖与构建产物（当前演示台零依赖用不到；为将来引入前端工程预置，防止误提交）
node_modules/
dist/

# ---------- 运行日志 ----------
logs/
**/logs/
*.log
*.log.gz

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# ---------- 本机环境 ----------
.env
.env.local
*.local
!.env.example

# ---------- 临时 / 验证产物 ----------
.verify/
tmp/
benchmark/report/
*.tmp
*.bak

# ---------- 闸门构建产物 ----------
# 指纹工具（CommentFingerprint / YamlFingerprint）与探针编译出的 class，
# 由 gates/gate-env.ps1 的 Initialize-GateClasses 按需生成，不入库。
gates/build/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 密钥库（JWT 签名私钥）----------
# 【注意】llmall.jks 是 JWT 签名私钥，**不入库**；首次 clone 后先跑 scripts/gen-jks.ps1 生成。
#         生产环境应改由卷挂载提供（llmall.jwt.location 支持 file: 前缀）并定期轮换。
*.jks
*.p12
